# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# macOS files
.DS_Store

# Project Binaries
/bin
.vscode/
*.log

# mediasoup-worker fetched by `make worker` (cmd/fetch-worker) plus its
# version marker used to invalidate the cached download on go.mod upgrades.
/mediasoup-worker
/mediasoup-worker.exe
/.mediasoup-version

# Broadcast verify script artefacts: per-run MP4 + frame PNGs +
# frames.txt land in test/broadcast/out/<variant>-<timestamp>/.
/test/broadcast/out/